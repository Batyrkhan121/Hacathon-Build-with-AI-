# Deny everything, then allow only the runtime inputs below.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/*.py
!prompts/*.md
!web/*.html
!web/*.css
!web/*.js
!web/mock/answer_sample.json
!web/vendor/**
!data/landmarks.json
!data/processed/poi.jsonl
!data/processed/REPORT.md
!data/index/embeddings.npy
!data/index/ids.json
!data/index/meta.json

# Defense in depth: these exclusions win over the allowlist.
data/cache
data/cache/**
data/raw
data/raw/**
data/manual
data/manual/**
.claude
.claude/**
.env
.env.*
**/.env
**/.env.*
**/.git
**/.git/**
**/.venv
**/.venv/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pem
**/*.key
**/credentials*
**/secrets*

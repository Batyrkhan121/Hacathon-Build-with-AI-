# Deny everything, then allow only the runtime inputs below.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/
!app/*.py
!prompts/
!prompts/*.md
!web/
!web/*.html
!web/*.css
!web/*.js
!web/mock/
!web/mock/answer_sample.json
!data/
!data/landmarks.json
!data/processed/
!data/processed/poi.jsonl
!data/processed/REPORT.md
!data/index/
!data/index/embeddings.npy
!data/index/ids.json
!data/index/meta.json

# Defense in depth: these exclusions win over the allowlist.
.env
.env.*
**/.env
**/.env.*
**/.git
**/.git/**
**/.venv
**/.venv/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pem
**/*.key
**/credentials*
**/secrets*

# Qadam — copy to .env and fill in. Never commit .env (it is in .gitignore).
# LLM: Claude (query parsing, card texts, POI descriptions)
ANTHROPIC_API_KEY=
# only for a user-level key (sk-ant-usr-...) not scoped to a workspace: Console -> Workspaces -> ID
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FALLBACK_MODEL=claude-haiku-5-5
# Embeddings (optional). Empty key -> retrieval is lexical.
# Provider: openrouter (OPENROUTER_API_KEY) or gemini (GEMINI_API_KEY).
# data/index is built through openrouter (google/gemini-embedding-001): keep EMBED_PROVIDER=openrouter,
# otherwise the index model does not match the query model and search falls back to words.
EMBED_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
LLM_ENABLED=true
# Walking routes on the OSM walk graph (data/processed/walk_graph.npz); false -> straight segments
WALK_GRAPH=true
LLM_TIMEOUT_S=20
H3_RES=9
# contact for the User-Agent of Overpass / Wikidata requests (good API citizenship)
QADAM_CONTACT=team@example.com

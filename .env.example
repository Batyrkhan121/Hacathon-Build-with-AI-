# Qadam — copy to .env and fill in. Never commit .env (it is in .gitignore).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
LLM_ENABLED=true
LLM_TIMEOUT_S=20
H3_RES=9
# contact for the User-Agent of Overpass / Wikidata requests (good API citizenship)
QADAM_CONTACT=team@example.com

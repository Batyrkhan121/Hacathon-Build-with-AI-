    {
      "name": "Search action",
      "kind": "button",
      "refersTo": "button-search",
      "description": "Yellow start action at the composer base; the arrow responds to interaction.",
      "html": "<button class=\"ds-search\">Find a walk<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-search{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:54px;padding:13px 16px;border:0;border-radius:8px;color:var(--ink,#202631);background:var(--gold,#f2b705);font:700 17px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,\"Noto Sans\",\"Helvetica Neue\",Arial,sans-serif;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,transform 100ms ease-out;}.ds-search:focus-visible{outline:3px solid var(--accent,#245fc5);outline-offset:3px;}.ds-search:active:not(:disabled){transform:scale(.97);}.ds-search:disabled{opacity:.65;cursor:wait;}.ds-search{box-sizing:border-box;justify-content:space-between;width:100%;transition:background-color 120ms ease-out;}.ds-search svg{transition:transform 160ms cubic-bezier(.16,1,.3,1);}.ds-search:hover{background:#e7ac00;}.ds-search:hover svg,.ds-search:focus-visible svg{transform:translateX(4px);}.ds-search:active{background:#da9f00;}.ds-search:active svg{transform:translateX(6px);}@media(prefers-reduced-motion:reduce){.ds-search,.ds-search svg{transition:none;transform:none!important;}}"
    },
    {

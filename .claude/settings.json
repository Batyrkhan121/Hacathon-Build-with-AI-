{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force,pre:bash:gateguard-fact-force,pre:powershell:gateguard-fact-force,stop:evaluate-session",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(.venv/Scripts/python *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/bin/python *)",
      "Bash(python -m venv *)",
      "Bash(py -m venv *)",
      "Bash(python --version)",
      "Bash(py --version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git worktree list *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(curl *)",
      "PowerShell(.venv\\Scripts\\python *)",
      "PowerShell(.venv/Scripts/python *)",
      "PowerShell(python -m venv *)",
      "PowerShell(py -m venv *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git branch *)",
      "PowerShell(git worktree list *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:googleapis.github.io)",
      "WebFetch(domain:wiki.openstreetmap.org)",
      "WebFetch(domain:overpass-api.de)",
      "WebFetch(domain:www.wikidata.org)",
      "WebFetch(domain:open-meteo.com)",
      "WebFetch(domain:h3geo.org)",
      "WebFetch(domain:leafletjs.com)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
